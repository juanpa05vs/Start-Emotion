        <mxCell id="c-clf" value="&lt;table border=&quot;0&quot; cellPadding=&quot;0&quot; cellSpacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr&gt;&lt;td align=&quot;center&quot; style=&quot;background-color:#FDF6E3;&quot;&gt;&lt;b&gt;BayesNaiveClassifier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;lt;&amp;lt;n&amp;#250acute;cleo de inferencia&amp;gt;&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;left&quot; style=&quot;border-top:1px solid #B58900;padding:6px;font-size:11px;&quot;&gt;&lt;i&gt;- modelo : BayesModel&lt;/i&gt;&lt;br&gt;&lt;i&gt;- features : FeatureRegistry&lt;/i&gt;&lt;br&gt;&lt;i&gt;- varianceFloor : float&lt;/i&gt;&lt;hr&gt;&lt;b&gt;+ {static}&lt;/b&gt; entrenarDesdeBd(n) : self&lt;br&gt;&lt;b&gt;+&lt;/b&gt; predecir(vector) : BayesResultado&lt;br&gt;&lt;b&gt;+&lt;/b&gt; probabilidades(vector) : array&lt;br&gt;&lt;b&gt;+&lt;/b&gt; logScores(vector) : array&lt;hr&gt;&lt;i&gt;- logVerosimilitudGaussiana(x, &amp;mu;, &amp;sigma;)&lt;/i&gt;&lt;br&gt;&lt;i&gt;- logSumExp(logs) : float&lt;/i&gt;&lt;br&gt;&lt;i&gt;- aplicarPisoSigma(&amp;sigma;) : float&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#B58900;fillColor=none;strokeWidth=2;" vertex="1" parent="pkg-bayes">

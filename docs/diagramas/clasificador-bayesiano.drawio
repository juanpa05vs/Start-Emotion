        <mxCell id="c-repo" value="&lt;table border=&quot;0&quot; cellPadding=&quot;0&quot; cellSpacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr&gt;&lt;td align=&quot;center&quot; style=&quot;background-color:#FDF6E3;&quot;&gt;&lt;b&gt;BayesModelRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;lt;&amp;lt;persistencia versionada&amp;gt;&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;left&quot; style=&quot;border-top:1px solid #B58900;padding:6px;font-size:11px;&quot;&gt;&lt;i&gt;- ruta, dirRespaldo&lt;/i&gt;&lt;hr&gt;&lt;b&gt;+&lt;/b&gt; existe() : bool&lt;br&gt;&lt;b&gt;+&lt;/b&gt; cargar() : BayesModel&lt;br&gt;&lt;b&gt;+&lt;/b&gt; guardar(modelo) : void&lt;br&gt;&lt;b&gt;+&lt;/b&gt; listarVersiones() : string[]&lt;br&gt;&lt;b&gt;+&lt;/b&gt; borrar() : void&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#B58900;fillColor=none;" vertex="1" parent="pkg-bayes">

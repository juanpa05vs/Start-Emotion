        <mxCell id="c-cmd" value="&lt;table border=&quot;0&quot; cellPadding=&quot;0&quot; cellSpacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr&gt;&lt;td align=&quot;center&quot; style=&quot;background-color:#FFF8E1;&quot;&gt;&lt;b&gt;EntrenarBayesCommand&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;lt;&amp;lt;command&amp;gt;&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;left&quot; style=&quot;border-top:1px solid #93A1A1;padding:6px;font-size:11px;&quot;&gt;&lt;b&gt;+&lt;/b&gt; handle() : int&lt;hr&gt;php artisan bayes:entrenar&lt;br&gt;&amp;nbsp;&amp;nbsp;--min-por-clase=N&lt;br&gt;&amp;nbsp;&amp;nbsp;--forzar&lt;br&gt;&amp;nbsp;&amp;nbsp;--evaluar&lt;hr&gt;&lt;b&gt;Nunca se ejecuta en una partida.&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#93A1A1;fillColor=none;" vertex="1" parent="pkg-cmd">

        <mxCell id="n4" value="mapearVectorPosicional&#10;[500, 2.0, 20000, 0, 95]&#10;&#8594; {latencia:500, tapping:2.0, ...}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#073642;fontSize=10;verticalAlign=bottom;" edge="1" parent="sw-inf" source="a-clf" target="a-fr2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="registro con nombre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#073642;fontSize=10;verticalAlign=bottom;" edge="1" parent="sw-inf" source="a-fr2" target="a-clf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="priors, mu, sigma" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#073642;fontSize=10;verticalAlign=bottom;" edge="1" parent="sw-inf" source="a-clf" target="a-mo2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;&lt;loop&gt;&gt; 5 clases &#215; 5 features&#10;logScorer(C) = log P(C) + &#8721;&#7522; log N(x&#7522; | &#956;&#7522;,C, &#963;&#7522;,C)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#B58900;fontSize=10;fontStyle=1;align=left;labelBackgroundColor=#F1F8F2;" edge="1" parent="sw-inf" source="a-clf" target="a-clf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Z = logsumExp({logScorer})&#10;P(C|x) = exp(logScorer(C) &#8722; Z)&#10;pred = argmax&#160;&#160;conf = P&#215;100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#073642;fontSize=10;align=left;labelBackgroundColor=#F1F8F2;" edge="1" parent="sw-inf" source="a-clf" target="a-clf">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="BayesResultado&#10;{prediccion, confianza,&#10;probabilidades, log_scores}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#073642;fontSize=10;verticalAlign=bottom;" edge="1" parent="sw-inf" source="a-clf" target="a-ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="INSERT telemetria_gameplay&#10;emocion_predicha &#8592; argmax&#10;diagnostico_correcto &#8592; (pred == objetivo)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#073642;fontSize=10;verticalAlign=bottom;" edge="1" parent="sw-inf" source="a-ctrl" target="a-db2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="201 Created&#10;{status, message, ia_output}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#073642;fontSize=10;verticalAlign=bottom;" edge="1" parent="sw-inf" source="a-ctrl" target="a-game">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&quot;Partida registrada.&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#073642;fontSize=10;verticalAlign=bottom;" edge="1" parent="sw-inf" source="a-game" target="a-u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nota-lse" value="Se normaliza el log-posterior, no el posterior.&#10;Ponderar exponenciales sin log-sum-exp da underflow a 0.0 en cuanto hay muchas features: el modelo devolver&#237;a &quot;ninguna clase&quot; sin avisar.&#10;&#10;El log-sum-exp mantiene la suma en 1.0." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;fillColor=#E8F0FE;strokeColor=#93A1A1;fontSize=11;spacing=8;" vertex="1" parent="sw-inf">
          <mxGeometry x="1140" y="590" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nota-priv" value="&#128274;&#160;El panel corre por separado, mucho despu&#233;s. Solo lee agregados y nunca identifica a nadie: la confianza de una partida no se muestra en admin/validacion-cientifica, porque el dato individual requiere consentimiento vigente.&#10;&#10;Lee: emocion_objetivo, emocion_predicha, diagnostico_correcto, latencia, tapping&#10;&#8594; colapsa 8 clases del juego a 5&#10;&#8594; matriz de confusi&#243;n [Real][Predicho] + accuracy, macro-F1, precision, recall" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#93A1A1;fontSize=11;spacing=8;" vertex="1" parent="sw-inf">
          <mxGeometry x="1140" y="730" width="390" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
# Entorno EXCLUSIVO para la suite de tests (php artisan test).
#
# Laravel carga este archivo automáticamente cuando APP_ENV=testing, y tiene
# PRIORIDAD sobre el .env normal. Esto aísla los tests de tu base de datos
# de desarrollo: RefreshDatabase nunca debe tocar `emociones` en MySQL.
#
# La APP_KEY de abajo es desechable y SOLO vale para tests.
# No la reutilices en staging/producción.

APP_NAME=StartEmotion
APP_ENV=testing
APP_KEY=base64:K6Bzk2/qYXJfXctmw/qFc0QVI4tZt7RdelwoydMKT5Y=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=4

# SQLite en memoria: se destruye al terminar cada test.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Array = todo en memoria, sin tablas de cache/queue/session en la BD.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Vacío a propósito: los tests de registro de Administrador deben quedar
# bloqueados salvo que sobreescriban config(['auth.admin_master_key' => ...]).
ADMIN_MASTER_KEY=
